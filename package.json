{
  "name": "slackoff",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive Slack bridge for opted-in OMP sessions",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "slackoff-daemon": "./dist/src/daemon/main.js"
  },
  "exports": {
    "./extension": "./dist/src/extension.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-extension.mjs",
    "build:extension": "node scripts/bundle-extension.mjs",
    "build:userscript": "node scripts/bundle-extension.mjs --userscript",
    "install:userscript": "tsx src/userscript-installer.ts",
    "watch:extension": "node scripts/bundle-extension.mjs --watch",
    "typecheck:extension": "tsc -p extension/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "5.0.0",
    "@slack/types": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.2.11",
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  }
}
